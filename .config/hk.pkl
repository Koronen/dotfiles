amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

min_hk_version = "2.0.0"

local shell_match_any =
  List(
    new FileSelector {
      glob =
        List(
          "**/*.sh",
          "**/*.bash",
          "**/*.zsh",
          "bash_profile",
          "bashrc",
          "tag-workstation/zlogin",
          "local/share/zsh/functions/*",
          "zshenv",
          "zshrc",
        )
    },
    new FileSelector { types = List("sh", "bash") },
  )

steps {
  ["mise"] = Builtins.mise
  ["pkl-format"] = Builtins.pkl_format
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = List("local/share/zsh/functions/prompt_koronen_setup")
    depends = "shfmt"
    match_any = shell_match_any
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any = shell_match_any
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["yamlfmt"] = Builtins.yamlfmt
  ["yamllint"] = (Builtins.yamllint) {
    depends = "yamlfmt"
  }
}
