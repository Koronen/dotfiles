amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.51.0"

local shell_match_any =
  List(
    new FileSelector {
      glob =
        List(
          "**/*.sh",
          "**/*.bash",
          "**/*.zsh",
          "bash_profile",
          "bashrc",
          "tag-workstation/zlogin",
          "zsh/functions/*",
          "zshenv",
          "zshrc",
        )
    },
    new FileSelector { types = List("sh", "bash") },
  )

local linters = new Mapping<String, Step> {
  ["mise"] = Builtins.mise
  ["pkl-format"] = Builtins.pkl_format
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = List("zsh/functions/prompt_koronen_setup")
    depends = "shfmt"
    match_any = shell_match_any
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any = shell_match_any
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["yamlfmt"] = Builtins.yamlfmt
  ["yamllint"] = (Builtins.yamllint) {
    depends = "yamlfmt"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
