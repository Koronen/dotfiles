#!/bin/sh

set -e

PACKS_PATH="$HOME/.vim/pack"

mkdir -p "$PACKS_PATH"

pack() {
  url="$1"
  ref="$2"
  plugin_path="${PACKS_PATH}/$3"

  if [ ! -d "$plugin_path" ]; then
    git clone "$url" "$plugin_path"
  else
    git -C "$plugin_path" fetch --quiet
  fi

  git -C "$plugin_path" checkout --quiet "$ref"
}

pack "https://github.com/bogado/file-line.git" "067ebe45dd3da0344d543b09441ee9b7fd886851" "plugins/start/file-line"
pack "https://github.com/ervandew/supertab.git" "8705ae0e43b34339c06328fa6dab24ecaf21aab6" "plugins/start/supertab"
pack "https://github.com/roman/golden-ratio.git" "636b8a1ea6bfe18296e61a8ac271b0101cb2ad3b" "plugins/start/golden-ratio"
pack "https://github.com/k-takata/minpac.git" "7a616ad2393139dbdf7514c14606098404e38625" "minpac/opt/minpac"

if [ -L "$HOME/.vim/spell/Makefile" ]; then
  pack "https://github.com/airblade/vim-gitgutter.git" "21c977e8597c468c7dc76001389b0b430d46a4b0" "plugins/start/vim-gitgutter"
  pack "https://github.com/junegunn/vim-peekaboo.git" "2a8a3187ba6b15201b2563a3f0331fcdf49da36c" "plugins/start/vim-peekaboo"
  pack "https://github.com/sheerun/vim-polyglot.git" "f061eddb7cdcc614c8406847b2bfb53099832a4e" "plugins/start/vim-polyglot"
fi
